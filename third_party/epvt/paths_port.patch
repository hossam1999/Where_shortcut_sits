+def _checkpoint_blocks(layers):
+    """Recompute each encoder block in the backward pass instead of storing its activations (16 GB GPU). The block's forward
+    is wrapped in place, so parameter names (and saved checkpoints) are unchanged. torchvision ViT-B/16 blocks have dropout 0
+    and no BatchNorm, so outputs and gradients are those of the plain block."""
+    for blk in layers:
+        f = blk.forward
+        def fwd(x, f=f, blk=blk):
+            if blk.training and torch.is_grad_enabled():
+                return torch.utils.checkpoint.checkpoint(f, x, use_reentrant=False)
+            return f(x)
+        blk.forward = fwd
+
+
